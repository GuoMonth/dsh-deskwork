{
  "name": "dsh-deskwork",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-driven experiments for the DSH Deskwork desktop workspace",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "docs:check": "node scripts/check-doc-links.ts",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/check.ts",
    "check:docs": "node scripts/check.ts --docs",
    "check:fresh": "node scripts/check.ts --fresh",
    "experiment:build": "tsc -p tsconfig.experiments.json",
    "experiment:prepare": "install-electron",
    "experiment:electron-session": "node scripts/run-electron-experiment.ts host",
    "experiment:electron-session:chromium": "node scripts/run-electron-experiment.ts chromium"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "electron": "44.2.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
